  "paths": {
    "/api/employer/{accountId}/funding-projection": {
      "post": {
        "tags": [
          "FundingProjection"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Version",
            "in": "header",
            "required": true,
            "example": "1.0"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostEmployerFundingProjectionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PostEmployerFundingProjectionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PostEmployerFundingProjectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EstimatesTimeline"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstimatesTimeline"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstimatesTimeline"
                }
              }
            }
          }
        }
      }
    },
