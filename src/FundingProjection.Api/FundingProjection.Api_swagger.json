      "put": {
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Version",
            "in": "header",
            "required": true,
            "example": "1.0"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutImportJobStateRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PutImportJobStateRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PutImportJobStateRequest"
              }
            }
          },
          "required": true
