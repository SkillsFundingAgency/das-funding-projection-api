  "components": {
    "schemas": {
      "EstimatesTimeline": {
        "type": "object",
        "properties": {
          "accountId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int64"
          },
          "projections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MonthlyFundingBreakdown"
            }
          }
        },
        "additionalProperties": false
      },
      "ImportJobStateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobName": {
            "$ref": "#/components/schemas/JobName"
          },
          "lastSuccessfulImportDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastAttemptedDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastAttemptSuccessful": {
            "type": "boolean"
          },
          "totalRecordsLastRun": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "failedRecordsLastRun": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "JobName": {
        "enum": [
          "ImportLearners"
        ],
        "type": "string"
      },
      "LevyInMonthSummary": {
        "required": [
          "period",
          "amount"
        ],
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LevyInSummary": {
        "type": "object",
        "properties": {
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "levyIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LevyOutSummary": {
        "type": "object",
        "properties": {
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "committedLearnerCost": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "committedLearnerFinalPaymentCost": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "committedTransferOut": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "committedTransferOutFinalPaymentCost": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "expiredLevy": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "MonthlyFundingBreakdown": {
        "required": [
          "levyInSummary",
          "levyOutSummary"
        ],
        "type": "object",
        "properties": {
          "employerAccountId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int64"
          },
          "month": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "closingBalance": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "levyInSummary": {
            "$ref": "#/components/schemas/LevyInSummary"
          },
          "levyOutSummary": {
            "$ref": "#/components/schemas/LevyOutSummary"
          }
        },
        "additionalProperties": false
      },
      "PostEmployerFundingProjectionRequest": {
        "type": "object",
        "properties": {
          "months": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "currentLevyFunds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "number",
            "format": "double"
          },
          "historicLevyIn": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LevyInMonthSummary"
            }
          }
        },
        "additionalProperties": false
      },
      "PutImportJobStateRequest": {
        "type": "object",
        "properties": {
          "lastSuccessfulImportDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastAttemptedDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastAttemptSuccessful": {
            "type": "boolean"
          },
          "totalRecordsLastRun": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          },
          "failedRecordsLastRun": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "FundingProjection"
    },
    {
      "name": "Jobs"
    },
    {
      "name": "Ping"
    }
  ]
